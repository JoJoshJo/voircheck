{
  "name": "voircheck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "build": "pnpm -r build",
    "spike": "tsx scripts/paypal-spike.ts",
    "db:generate": "pnpm --filter @voircheck/db generate",
    "db:migrate": "pnpm --filter @voircheck/db migrate",
    "db:seed": "pnpm --filter @voircheck/db seed",
    "db:verify": "pnpm --filter @voircheck/db verify",
    "scan": "tsx scripts/scan.ts",
    "search": "tsx scripts/search.ts",
    "paypal-check": "tsx scripts/paypal-check.ts",
    "webhooks:redact": "tsx scripts/redact-webhook-events.ts",
    "retention:run": "tsx scripts/retention.ts",
    "eval:run": "tsx scripts/eval-run.ts",
    "kernel:proxy": "tsx scripts/kernel-proxy.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "dotenv": "^16.4.7",
    "eslint": "^10.13.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@voircheck/agent": "workspace:*",
    "@voircheck/db": "workspace:*",
    "@voircheck/paypal": "workspace:*",
    "@voircheck/scanner": "workspace:*",
    "drizzle-orm": "^0.45.4"
  }
}
