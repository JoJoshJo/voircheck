PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYEE_A_EMAIL=
PAYEE_B_EMAIL=
PAYPAL_WEBHOOK_ID=
# Optional: saved sandbox wallet for scripts/paypal-check.ts (falls back to the spike's local results)
PAYPAL_VAULT_ID=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Scanner (spec 5.5)
KERNEL_API_KEY=
# Optional: KERNEL ISP proxy id from `pnpm kernel:proxy` (routes scans through an ISP IP; never stealth / CAPTCHA solving)
KERNEL_PROXY_ID=
GOOGLE_SAFE_BROWSING_API_KEY=

# Product search (spec 5.4)
CHANNEL3_API_KEY=

# Web app
DEMO_STORES_BASE_URL=https://voircheck-stores.onrender.com
# Demo stores: where "Buy through VoirCheck" sends people (default https://voircheck.com)
VOIRCHECK_APP_URL=https://voircheck.com

# Trust Receipt emails (Resend, mail.voircheck.com)
RESEND_API_KEY=
EMAIL_FROM=VoirCheck <receipts@mail.voircheck.com>
# Public app URL used in email links (falls back to the request origin)
APP_URL=https://voircheck-web.onrender.com
# AI providers (spec 5.13, $0 for AI): free providers first, Claude last.
# Page analysis: Groq qwen -> Gemini Flash-Lite -> OpenRouter free -> Claude (no gpt-oss).
# Shopping agent: Groq qwen -> gpt-oss-120b -> gpt-oss-20b -> OpenRouter free -> Claude. Never Gemini (user chat stays
# off Google's free tier). Web research is Claude-only.
# NEVER add a card or link billing on the Groq, Gemini (Google Cloud) or OpenRouter accounts behind these keys:
# the code only asks for free models, but only the account can guarantee nothing is ever charged.
GROQ_API_KEY=
# Optional override of the FIRST Groq model only; must be a fast model. Default qwen/qwen3.8-27b
GROQ_MODEL=
# Google AI Studio key, page analysis only (public store pages). Free tier, no billing linked.
GEMINI_API_KEY=
# Optional; must be a free-tier Flash-Lite (gemini-3.5-flash-lite or gemini-3.1-flash-lite, anything else is refused)
GEMINI_MODEL=
OPENROUTER_API_KEY=
# Optional override; must end in ":free" (anything else is refused). Default nvidia/nemotron-3.5-lightning:free
OPENROUTER_MODEL=
# Second free model, tried after the first; must end in ":free". Default nvidia/nemotron-3.5-super-vl:free
OPENROUTER_BACKUP_MODEL=
# Claude: last backup for page analysis and the agent (Haiku 5.5), and the only provider for web research.
# Leave empty for $0 AI: with no key nothing is ever sent to Claude.
ANTHROPIC_API_KEY=
SCAN_MODEL=claude-sonnet-5-5
# Research step (web search about the store, own daily budget). Set to off to turn it off.
RESEARCH=on
# Shopping agent model; "fake" = scripted offline agent
AGENT_MODEL=claude-sonnet-5-5
